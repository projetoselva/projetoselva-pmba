# ===========================================
# CONFIGURAÇÃO SUPABASE - @projetoselva
# ===========================================
# 
# 1. Acesse https://supabase.com e crie uma conta gratuita
# 2. Crie um novo projeto
# 3. Vá em Settings > API e copie as chaves abaixo
# 4. Renomeie este arquivo para .env.local
#
# ===========================================

# URL do seu projeto Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima (Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# ===========================================
# OPCIONAL: Configurações adicionais
# ===========================================

# URL base da aplicação (para produção)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app
